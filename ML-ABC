# Mutual Learning-based Artificial Bee Colony (ML-ABC) Algorithm
class ML_ABC:
    def __init__(self, num_bees, num_dimensions, x_min, x_max, max_cycles, F, trial_limit):
        self.num_bees = num_bees
        self.num_dimensions = num_dimensions
        self.x_min = x_min
        self.x_max = x_max
        self.max_cycles = max_cycles
        self.F = F
        self.trial_limit = trial_limit
        self.best_solution = None
        self.best_fitness = np.inf
        self.population = np.random.rand(num_bees, num_dimensions) * (x_max - x_min) + x_min
        self.fitness_values = np.array([fitness_function(ind) for ind in self.population])
        self.trial_count = np.zeros(self.num_bees)  # Counter for unsuccessful iterations

    def employed_bee_phase(self):
        for i in range(self.num_bees):
            k = np.random.randint(self.num_bees)
            while k == i:
                k = np.random.randint(self.num_bees)
            
            for j in range(self.num_dimensions):
                phi = np.random.uniform(-self.F, self.F)
                # Update the solution based on fitness comparison between current solution and the selected neighbor
                if self.fitness_values[i] < self.fitness_values[k]:
                    self.population[i, j] += phi * (self.population[k, j] - self.population[i, j])
                else:
                    self.population[i, j] += phi * (self.population[i, j] - self.population[k, j])

                # Ensure the solution is within the bounds
                self.population[i, j] = np.clip(self.population[i, j], self.x_min[j], self.x_max[j])
            
            # Recalculate fitness
            new_fitness = fitness_function(self.population[i])
            if new_fitness < self.fitness_values[i]:
                self.fitness_values[i] = new_fitness
                self.trial_count[i] = 0  # Reset trial count if improvement
            else:
                self.trial_count[i] += 1

            # Update the best solution found
            if new_fitness < self.best_fitness:
                self.best_fitness = new_fitness
                self.best_solution = self.population[i]

    def onlooker_bee_phase(self):
        total_fitness = np.sum(self.fitness_values)
        probabilities = self.fitness_values / total_fitness
        
        for i in range(self.num_bees):
            if np.random.rand() < probabilities[i]:
                k = np.random.randint(self.num_bees)
                while k == i:
                    k = np.random.randint(self.num_bees)

                for j in range(self.num_dimensions):
                    phi = np.random.uniform(-self.F, self.F)
                    if self.fitness_values[i] < self.fitness_values[k]:
                        self.population[i, j] += phi * (self.population[k, j] - self.population[i, j])
                    else:
                        self.population[i, j] += phi * (self.population[i, j] - self.population[k, j])

                    # Ensure the solution is within the bounds
                    self.population[i, j] = np.clip(self.population[i, j], self.x_min[j], self.x_max[j])

                # Recalculate fitness
                new_fitness = fitness_function(self.population[i])
                if new_fitness < self.fitness_values[i]:
                    self.fitness_values[i] = new_fitness
                    self.trial_count[i] = 0
                else:
                    self.trial_count[i] += 1

                # Update the best solution found
                if new_fitness < self.best_fitness:
                    self.best_fitness = new_fitness
                    self.best_solution = self.population[i]

    def scout_bee_phase(self):
        for i in range(self.num_bees):
            if self.trial_count[i] > self.trial_limit:
                # Randomly reinitialize the solution if not improved for 'trial_limit' iterations
                self.population[i] = np.random.rand(self.num_dimensions) * (self.x_max - self.x_min) + self.x_min
                self.fitness_values[i] = fitness_function(self.population[i])
                self.trial_count[i] = 0

    def optimize(self):
        for cycle in range(self.max_cycles):
            self.employed_bee_phase()
            self.onlooker_bee_phase()
            self.scout_bee_phase()
            
            print(f"Cycle {cycle+1}/{self.max_cycles}, Best Fitness: {self.best_fitness}")

        return self.best_solution, self.best_fitness
